# Copy this file to inventory/group_vars/app/vault.yml, put real values there,
# then encrypt it with:
#   .venv/bin/ansible-vault encrypt inventory/group_vars/app/vault.yml
#
# Do not commit plaintext secrets.

vault_registry_username: ""
vault_registry_password: ""

vault_app_secret_env:
  SPRING_DATASOURCE_URL: ""
  SPRING_DATASOURCE_USERNAME: ""
  SPRING_DATASOURCE_PASSWORD: ""
  STORAGE_S3_BUCKET: ""
  STORAGE_S3_REGION: ""
  STORAGE_S3_ENDPOINT: ""
  STORAGE_S3_ACCESSKEY: ""
  STORAGE_S3_SECRETKEY: ""
  STORAGE_S3_CDNURL: ""
