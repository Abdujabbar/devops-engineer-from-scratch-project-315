# Copy this file to inventory/group_vars/app/vault.yml, put real values there,
# then encrypt it with:
#   .venv/bin/ansible-vault encrypt inventory/group_vars/app/vault.yml
#
# Do not commit plaintext secrets.

vault_registry_username: ""
vault_registry_password: ""
vault_postgres_host: ""
vault_postgres_port: "6432"
vault_postgres_database: "bulletins"
vault_postgres_username: ""
vault_postgres_password: ""
vault_postgres_ssl_mode: "verify-full"
vault_postgres_target_server_type: "master"
vault_postgres_target_session_attrs: "read-write"
vault_spring_profiles: "prod"
vault_letsencrypt_email: ""

vault_s3_bucket: "project-devops-deploy-images"
vault_s3_region: "ru-central1"
vault_s3_endpoint: "https://storage.yandexcloud.net"
vault_s3_access_key: ""
vault_s3_secret_key: ""
vault_s3_cdn_url: ""

# Deprecated compatibility form; prefer vault_s3_* variables above.
vault_app_secret_env:
  STORAGE_S3_BUCKET: ""
  STORAGE_S3_REGION: ""
  STORAGE_S3_ENDPOINT: ""
  STORAGE_S3_ACCESSKEY: ""
  STORAGE_S3_SECRETKEY: ""
  STORAGE_S3_CDNURL: ""
